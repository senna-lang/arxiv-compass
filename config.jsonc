{
  // 取得対象のarXivカテゴリ
  "categories": ["cs.CL", "cs.LG", "cs.AI", "cs.CR"],

  // 日次パース時の最大取得件数（parse.pyは trend.md のIDリストを使うので実質未使用）
  "max_results_daily": 200,

  // 月次地図生成時の最大取得件数（npm run map で使用）
  "max_results_map": 10000,

  // Embeddingモデル。全スクリプトで共通。変更時は map.json を再生成すること
  "embedding_model": "allenai/specter2_base",

  // daily-news skill が生成する YYYYMMDD-trend.md の保存先ディレクトリ
  "trend_dir": "/Users/senna/Documents/Repos/life/ideas/daily",

  // JSONの出力先（parse.py / map.py / recommend.py の成果物）
  "output_dir": "data",

  // スコアリングの基準となる興味領域（自然言語で記述）
  // 論文abstractとのcos類似度の平均がdailyスコアになる
  "interest_profile": [
    "LLM inference optimization and serving efficiency",
    "attention mechanism variants and efficient transformers",
    "large language model internals and interpretability",
    "tokenization and embedding representations",
    "MLOps and LLM deployment infrastructure",
    "prompt injection and LLM security attacks",
    "AI agent tool use and reasoning",
  ],

  // Cloudflare KV から ratings を取得するURL（recommend.py が使用）
  // 空文字列にすると data/ratings.json にフォールバック
  "ratings_url": "",

  // recommend.py のフィルタリング設定
  "recommendation": {
    "min_rating": 2, // この星評価以上の論文をinstance-based scoringに使用
    "top_clusters": 3, // 上位何クラスタからおすすめを生成するか
    "top_n": 20, // 最終的なおすすめ件数の上限
    "min_match_score": 0.60, // クラスタcentroidとのcos類似度がこれ未満の論文を除外
    // セレンディピティ: 隣接クラスタ（rank 4-6）の代表論文 + 意図的に遠いクラスタの論文を混在
    "serendipity_clusters": 3,           // 隣接クラスタ数（rank 4〜4+N）
    "serendipity_top_n": 7,              // 隣接クラスタから取る件数
    "serendipity_min_match_score": 0.80, // 隣接クラスタ内の代表論文フィルタ
    "serendipity_distant_clusters": 2,   // さらに遠いクラスタ数（後ろから取る）
    "serendipity_distant_top_n": 3,      // 遠いクラスタから取る件数
  },

  // fetch_daily.py の設定
  "fetch_daily": {
    "look_back_days": 2, // 何日前まで遡るか（週末対応）
    "max_candidates": 300, // arXiv から取得する最大候補数
    "top_n": 20, // 最終的に保存する論文数
    "dedupe_days": 30, // 重複除去対象の過去日数
  },

  // チューニングパラメータ。変更後は該当スクリプトを再実行すること
  // map系パラメータを変えたら npm run map で地図を再生成する必要がある
  "tuning": {
    "map": {
      "pca_components": 50, // specter2の768次元をこの次元に削減してからUMAPへ渡す
      "umap_n_neighbors": 50, // 近傍点数。大きいほどグローバル構造重視、小さいほどローカル構造重視
      "hdbscan_min_cluster_size_divisor": 200, // max_papers ÷ この値 = min_cluster_size の計算式の分母
      "hdbscan_min_cluster_size_floor": 15, // min_cluster_sizeの下限。これより小さいクラスタは作らない
      "hdbscan_min_samples": 5, // ノイズ判定の閾値。小さいほどノイズが減りクラスタが増える
      "vectorizer_min_df": 3, // 最低N件の文書に出現しない語をキーワード候補から除外
      "keybert_nr_repr_docs": 10, // KeyBERTがクラスタを代表させる文書数
      "keybert_nr_candidate_words": 50, // c-TF-IDFで抽出するキーワード候補数。多いほど意味的再ランキングの精度が上がる
      "keybert_top_n_words": 10, // 最終的に採用するキーワード数（ラベルには先頭3語を使用）
      "mmr_diversity": 0.3, // キーワードの多様性。0=cos類似度重視、1=冗長排除重視
    },
    "recommend": {
      "alpha_ratings_threshold": 50, // ratings件数がこの値に達するとprofile依存からinstance依存に完全移行
    },
  },
  // SPECTER の選出順は変えない。表示中の20件だけを local Jev で shadow ranking する。
  "shadow_jev": {
    "model": {
      "base_id": "Qwen/Qwen3-4B-Instruct-2507",
      "base_revision": "cdbee75f17c01a7cc42f958dc650907174af0554",
      "adapter_id": "e2-lr-1e-4-epoch-3-quarter-3",
      "adapter_sha256": "c05bbb97c39acd584b37d59287bed8c2cb923f25a9070d0b6e06996b978c4f30",
      "inference_version": "1",
    },
    "predicate": {
      "id": "arxiv-current-research-usefulness",
      "version": "2",
      "current_project_context": [
        "building and measuring coding-agent harness tooling: token reduction for shell and tool output, cross-harness handoff, context compression with recovery of folded content, agent memory",
        "designing evaluations for coding agents and harnesses: benchmark design, paired comparisons, LLM-as-judge reliability, small open models under different harnesses",
        "building a local Jev-style structured-decision model (Qwen3-4B + LoRA distilled from a teacher's option probabilities, tree-packed multi-branch inference) and finding practical uses for it",
        "following post-training and distillation methods, agent-to-agent communication formats, and agent-native code navigation (LSP and AST)",
      ],
      "preference": "Prioritize papers likely to change an implementation, experiment, or system-design decision. Mere topical similarity is not enough.",
      "question": "Would reading this paper likely provide concrete information that changes an implementation, experiment, or system-design decision for this user?",
      "options": ["No", "Yes"],
    },
    "batch_size": 2,
    "timeout_seconds": 180,
}

}
